# 認証情報・環境依存設定
.env

# CakePHP
backend/vendor/
backend/tmp/
backend/logs/
backend/.phpunit.cache/

# Docker ボリューム
*.log

# OS
.DS_Store
# Excel 一時ロックファイル
~$*.xls
~$*.xlsx
~$*.xlsm
frontend/.next
.idea
/frontend/node_modules/
/backend/.phpunit.cache/test-results

# ビルドの中間ファイル（毎回差分に出るだけで、中身に意味がない）
*.tsbuildinfo

# Terraform の作業ディレクトリ。プロバイダのバイナリが 250MB あり、
# tfvars/tfplan には OCID や鍵のパスが入るので置かない
infra/**/.terraform/
infra/**/.terraform.lock.hcl
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfplan
infra/**/*.tfvars
infra/**/*.tfvars.json
