# kamaho-shokusu.jp API 認証情報
KAMAHO_BASE_URL=https://kamaho-shokusu.jp
KAMAHO_LOGIN_ACCOUNT=your-account
KAMAHO_LOGIN_PASSWORD=your-password

# DB
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=meal_order_db
MYSQL_USER=cake_user
MYSQL_PASSWORD=secret

# Host port settings for Docker Compose
WEB_PORT=80
FRONTEND_PORT=3000
DB_PORT=3306

# AI公開設定
AI_PUBLIC_ENABLED=true
NEXT_PUBLIC_AI_PUBLIC_ENABLED=true

# LLM Provider (openrouter / groq)
AI_PROVIDER=openrouter

# Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter API (AI_PROVIDER=openrouter の場合)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=meal-order-system
