# 保存する資格情報（kamaho連携パスワードなど）の暗号化に使う鍵。
# 必ず環境ごとに固有の値を設定すること。既定値のまま運用すると、
# DBが1つ漏れただけで保存済みの資格情報がすべて復号できてしまう。
# 生成例: openssl rand -hex 32
# 変更すると保存済みの資格情報は復号できなくなり、再連携が必要になる。
SECURITY_SALT=

# kamaho-shokusu.jp API 認証情報
KAMAHO_BASE_URL=https://kamaho-shokusu.jp
KAMAHO_LOGIN_ACCOUNT=your-account
KAMAHO_LOGIN_PASSWORD=your-password

# DB
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=meal_order_db
MYSQL_USER=cake_user
MYSQL_PASSWORD=secret

# Host port settings for Docker Compose
WEB_PORT=8090
FRONTEND_PORT=3003
DB_PORT=3310

# AI公開設定
AI_PUBLIC_ENABLED=true
NEXT_PUBLIC_AI_PUBLIC_ENABLED=true

# LLM Provider (openrouter / groq)
AI_PROVIDER=openrouter

# Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter API (AI_PROVIDER=openrouter の場合)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# openrouter/free は毎回ランダムな無料モデルにルーティングされる（当たり外れあり）
# 無料枠の上限は 50リクエスト/日。1回のAI生成で最大3回消費するため実質15〜20回で枯れる。
# リセットは毎日 09:00(JST)。上限を外すには OpenRouter にクレジット追加（$10で1000リクエスト/日）。
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=meal-order-system
