# Dev/本番サーバー用の設定。.env.prod にコピーして使う。
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ブラウザからアクセスするURL。フロントのビルド時に焼き込まれるため、
# 変えたら --build でビルドし直す必要がある
PUBLIC_BASE_URL=http://<サーバーのIP または ドメイン>

# 保存する資格情報（kamaho連携パスワードなど）の暗号化に使う鍵。
# 必ず環境ごとに固有の値にすること。未設定だと起動しない。
# 生成例: openssl rand -hex 32
# 変更すると保存済みの資格情報は復号できなくなり、再連携が必要になる
SECURITY_SALT=

# データベース
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=meal_order_db
MYSQL_USER=meal_order
MYSQL_PASSWORD=

# kamaho 連携（使わないなら空のまま）
KAMAHO_BASE_URL=
KAMAHO_LOGIN_ACCOUNT=
KAMAHO_LOGIN_PASSWORD=

# AI機能。Dev環境では既定で無効にしてある
AI_PUBLIC_ENABLED=false

# ollama / openrouter / groq
#
# ollama を勧めます。openrouter の無料枠は 50回/日で、毎回ちがうモデルに
# 回されます。分類用モデルや、中国語で考えて途中で尽きるモデルに当たると
# そのまま失敗します。献立の材料を21件作るだけで枠が尽きました。
# ollama なら回数制限が無く、モデルも固定できます。
AI_PROVIDER=ollama

# LLM機（Ampere A1）の内部IP。deploy/setup-ollama.sh で用意する。
# アプリ機は 1GB しかなくモデルが載らないので、別の機械に置く。
# Ollama には認証が無いため、内部ネットワークからのみ届くようにしてある
OLLAMA_BASE_URL=http://10.0.1.0:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# AI_PROVIDER=openrouter のときだけ使う。
# openrouter/free は毎回ランダムなモデルに回されるので、使うなら
# 指示に素直なモデルを名前で固定すること
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
