# Dev/本番サーバー用の設定。.env.prod にコピーして使う。
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ブラウザからアクセスするURL。フロントのビルド時に焼き込まれるため、
# 変えたら --build でビルドし直す必要がある
PUBLIC_BASE_URL=http://<サーバーのIP または ドメイン>

# 保存する資格情報（kamaho連携パスワードなど）の暗号化に使う鍵。
# 必ず環境ごとに固有の値にすること。未設定だと起動しない。
# 生成例: openssl rand -hex 32
# 変更すると保存済みの資格情報は復号できなくなり、再連携が必要になる
SECURITY_SALT=

# データベース
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=meal_order_db
MYSQL_USER=meal_order
MYSQL_PASSWORD=

# kamaho 連携（使わないなら空のまま）
KAMAHO_BASE_URL=
KAMAHO_LOGIN_ACCOUNT=
KAMAHO_LOGIN_PASSWORD=

# AI機能。Dev環境では既定で無効にしてある
AI_PUBLIC_ENABLED=false
AI_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
